{
  "name": "brainsprint-kids",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/copy-apk.mjs",
    "preview": "vite preview",
